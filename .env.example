# ==========================================
# VIA CLOTHING — FULL-STACK ENVIRONMENT VARIABLES
# ==========================================

# Client (Vite)
VITE_API_URL=http://localhost:5001/api
VITE_RAZORPAY_KEY_ID=rzp_test_placeholder

# Server
PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Connection String (Atlas or local)
# Note: If left blank or connection fails, the server gracefully initializes an in-memory dev database for zero-config local testing.
MONGO_URI=mongodb://127.0.0.1:27017/via_clothing

# JWT Authentication
JWT_SECRET=via_secret_jwt_key_streetwear_2026_identity_token_secure
JWT_EXPIRES_IN=7d
COOKIE_EXPIRES_IN=7

# Razorpay (Payments)
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=rzp_secret_placeholder
RAZORPAY_WEBHOOK_SECRET=

# Cloudinary (Image Management)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email Notifications (Resend / SMTP)
EMAIL_FROM=orders@viaclothing.in
EMAIL_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
