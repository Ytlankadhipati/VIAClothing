# ==========================================
# VIA CLOTHING — .gitignore
# ==========================================

# Node dependencies — never commit these
node_modules/
frontend/node_modules/
backend/node_modules/

# Build output
dist/
frontend/dist/

# Environment files — NEVER commit secrets
.env
.env.local
.env.*.local
frontend/.env
frontend/.env.local
backend/.env
backend/.env.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor directories
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# MongoDB memory server binary cache
backend/node_modules/.cache/
